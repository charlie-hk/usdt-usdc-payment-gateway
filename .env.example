# --- Deployment (Sepolia) ---
# RPC endpoint from Alchemy, Infura, QuickNode, etc.
SEPOLIA_RPC_URL=
# Private key of a throwaway deployer wallet funded with Sepolia ETH. Never use a wallet that holds real funds.
DEPLOYER_PRIVATE_KEY=
# From https://etherscan.io/myapikey (one key covers every chain via the Etherscan V2 API)
ETHERSCAN_API_KEY=

# --- Optional deployment settings ---
# OWNER_ADDRESS=            # defaults to the deployer
# FEE_BPS=50                # protocol fee in basis points (max 500)
# USDC_ADDRESS=             # use an existing USDC (defaults to Circle's Sepolia USDC on Sepolia)
# USDT_ADDRESS=             # use an existing USDT (defaults to deploying MockUSDT)
# USE_MOCK_USDC=true        # deploy MockUSDC instead of using Circle's USDC on Sepolia

# --- Optional: only if the Solidity compiler download is blocked on your network ---
# USE_SOLCJS=true
