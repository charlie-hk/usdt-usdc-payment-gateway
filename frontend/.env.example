# Optional. Without it the "WalletConnect" button is hidden and only a browser-extension wallet can connect.
# Create a free project ID in the Reown (formerly WalletConnect) dashboard.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional. Read-only RPC used before a wallet is connected and for the dashboard's event scan.
# Defaults to viem's public Sepolia endpoint, which is rate-limited.
VITE_SEPOLIA_RPC_URL=
